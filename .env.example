# お問い合わせフォーム（LINE 送信）用の環境変数サンプル
# このファイルをコピーして .env.local を作成し、実際の値を設定してください。
#   cp .env.example .env.local
# ※ .env.local はコミットしないでください（.gitignore 対象）。

# LINE Messaging API のチャネルアクセストークン
# LINE Developers Console → 対象チャネル → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=
# 送信先の LINE グループ ID（"C" で始まる文字列）
# Bot をグループに招待し、Webhook イベントの source.groupId から取得します。
LINE_GROUP_ID=

# ===== SEO =====
# 本番サイトの URL（末尾スラッシュなし。例: https://example.com）
# 未設定時は Vercel の本番URL → localhost にフォールバックします。canonical/OGP/sitemap で使用。
NEXT_PUBLIC_SITE_URL=
# Google Search Console の所有権確認トークン（メタタグ方式の content 値）
# 設定すると <meta name="google-site-verification"> が出力されます。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
